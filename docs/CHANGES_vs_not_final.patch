+    s = pd.DataFrame({"date": df["date"].to_numpy(), "m": mins}).sort_values(["date", "m"])
+    new = s.groupby("date")["m"].diff().fillna(np.inf) > gap_min
+    return new.groupby(s["date"]).sum().astype(float)
