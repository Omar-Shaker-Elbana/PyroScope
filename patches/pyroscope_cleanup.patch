-
-def assign_cells(
-    lat: Sequence[float], lon: Sequence[float], cell_deg: float = DEFAULT_CELL_DEG
-) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:
-    """Assign each (lat, lon) to a cell on the same kind of lat/lon grid
-    calendar_cells.csv already uses, and return (cell_id, cell_lat,
-    cell_lon): a string id and the CENTRE coordinates of that cell.
-    """
-    lat = np.asarray(lat, dtype=float)
-    lon = np.asarray(lon, dtype=float)
-    lat_idx = np.floor(lat / cell_deg).astype(np.int64)
-    lon_idx = np.floor(lon / cell_deg).astype(np.int64)
-    cell_id = np.array([f"{a}_{b}" for a, b in zip(lat_idx, lon_idx)])
-    cell_lat = (lat_idx + 0.5) * cell_deg
-    cell_lon = (lon_idx + 0.5) * cell_deg
-    return cell_id, cell_lat, cell_lon
-
-
-@dataclass
-class CellDayTable:
-    counts: np.ndarray  # (n_cells, n_days) float
-    cell_ids: List[str]
-    cell_coords: Dict[str, Tuple[float, float]]  # cell_id -> (lat, lon) centre
-    dates: "object"  # pandas.DatetimeIndex, one entry per column of counts
-    point_cell_idx: np.ndarray  # (n_points,) int, row into counts/cell_ids
-    point_day_idx: np.ndarray  # (n_points,) int, column into counts/dates
-
-
-def build_cell_day_table(
-    df,
-    date_col: str = "acq_date",
-    lat_col: str = "latitude",
-    lon_col: str = "longitude",
-    cell_deg: float = DEFAULT_CELL_DEG,
-    cell_id_col: Optional[str] = None,
-) -> CellDayTable:
-    """Turn a detections table into a (cell x day) count matrix, plus the
-    per-point (cell, day) indices the Monte Carlo permutation step needs.
-
-    If ``cell_id_col`` is given, cells are taken from that column
-    directly (e.g. an existing calendar_cells.csv ``cell_id``) instead of
-    being recomputed from lat/lon, so the two never drift apart; its
-    centre coordinates are still read from ``lat_col`` / ``lon_col`` on
-    a representative row of each cell (only used for neighbour
-    ordering, so an approximate centre is fine).
-    """
-    import pandas as pd
-
-    work = df.copy()
-    if cell_id_col is None:
-        cid, clat, clon = assign_cells(work[lat_col], work[lon_col], cell_deg)
-        work["_cell_id"] = cid
-        coord_lookup: Dict[str, Tuple[float, float]] = {}
-        for c, a, b in zip(cid, clat, clon):
-            coord_lookup.setdefault(c, (float(a), float(b)))
-    else:
-        work["_cell_id"] = work[cell_id_col].astype(str)
-        coord_lookup = {}
-        for c, a, b in zip(work["_cell_id"], work[lat_col], work[lon_col]):
-            coord_lookup.setdefault(c, (float(a), float(b)))
-
-    work["_date"] = pd.to_datetime(work[date_col]).dt.normalize()
-    cell_ids = sorted(work["_cell_id"].unique())
-    cell_index = {c: i for i, c in enumerate(cell_ids)}
-    dates = pd.date_range(work["_date"].min(), work["_date"].max(), freq="D")
-    day_index = {d: i for i, d in enumerate(dates)}
-
-    point_cell_idx = work["_cell_id"].map(cell_index).to_numpy(dtype=np.int64)
-    point_day_idx = work["_date"].map(day_index).to_numpy(dtype=np.int64)
-    counts = _rebuild_counts(point_cell_idx, point_day_idx, len(cell_ids), len(dates))
-    cell_coords = {c: coord_lookup[c] for c in cell_ids}
-
-    return CellDayTable(
-        counts=counts,
-        cell_ids=cell_ids,
-        cell_coords=cell_coords,
-        dates=dates,
-        point_cell_idx=point_cell_idx,
-        point_day_idx=point_day_idx,
-    )
-
-
-def _rebuild_counts(cell_idx: np.ndarray, day_idx: np.ndarray, n_cells: int, n_days: int) -> np.ndarray:
-    """(cell x day) count matrix from per-point indices -- O(n_points),
-    used both for the observed table and for every Monte Carlo replicate
-    (where day_idx has been permuted but cell_idx has not)."""
-    flat = cell_idx * n_days + day_idx
-    return np.bincount(flat, minlength=n_cells * n_days).astype(float).reshape(n_cells, n_days)
-
-
-def neighbor_order(cell_ids: Sequence[str], cell_coords: Dict[str, Tuple[float, float]]) -> np.ndarray:
-    """For every cell, the indices of all cells ordered by increasing
-    (approximate) distance from it, itself first. Growing a spatial zone
-    by taking the first ``k`` entries of one row gives a nested sequence
-    of circular zones around that seed cell."""
-    n = len(cell_ids)
-    lat = np.array([cell_coords[c][0] for c in cell_ids])
-    lon = np.array([cell_coords[c][1] for c in cell_ids])
-    order = np.empty((n, n), dtype=np.int64)
-    for i in range(n):
-        dlat = (lat - lat[i]) * KM_PER_DEG
-        dlon = (lon - lon[i]) * KM_PER_DEG * np.cos(np.radians(lat[i]))
-        order[i] = np.argsort(dlat**2 + dlon**2, kind="stable")
-    return order
-
-
-# --------------------------------------------------------------------------- statistic
-
-
-def kulldorff_llr(obs, exp, total: float) -> np.ndarray:
-    """Kulldorff's (1997) log-likelihood-ratio statistic for an EXCESS of
-    count ``obs`` where ``exp`` is the null-expected count and ``total``
-    is the grand total over the whole space-time study region.
-    Vectorized over ``obs`` / ``exp`` arrays of matching shape.
-
-    Only excess is scored (``obs <= exp`` -> 0): this project is looking
-    for a real spatiotemporal spike, never an anomalously QUIET cluster,
-    matching how the rest of the anomaly pipeline only flags elevated
-    activity. Degenerate inputs (exp <= 0, or exp/obs at the grand
-    total) also score 0 rather than raising, since a predominantly empty
-    permuted replicate can produce them.
-    """
-    obs = np.asarray(obs, dtype=float)
-    exp = np.asarray(exp, dtype=float)
-    llr = np.zeros(np.broadcast(obs, exp).shape)
-    ok = (obs > exp) & (exp > 0) & (exp < total) & (obs < total)
-    o, e = obs[ok], exp[ok]
-    llr[ok] = o * np.log(o / e) + (total - o) * np.log((total - o) / (total - e))
-    return llr
-
-
-def _scan_core(
-    counts: np.ndarray,
-    order: np.ndarray,
-    max_spatial_cells: int,
-    min_window_days: int,
-    max_window_days: int,
-    want_table: bool,
-):
-    """One full cylinder scan of a (cell x day) count table.
-
-    Returns (best, table): ``best`` is (llr, seed_idx, zone_size, start,
-    length) for the single most likely cluster; ``table`` is the same
-    5-tuple for every candidate cylinder when ``want_table`` is True
-    (used to extract secondary clusters), else None (the fast path used
-    for every Monte Carlo replicate, where only the maximum is needed).
-    """
-    n_cells, n_days = counts.shape
-    max_spatial_cells = min(max_spatial_cells, n_cells)
-    max_window_days = min(max_window_days, n_days)
-
-    day_totals = counts.sum(axis=0)
-    day_cum = np.concatenate(([0.0], np.cumsum(day_totals)))
-    grand_total = float(day_totals.sum())
-
-    best = (-1.0, -1, 0, 0, 0)
-    table: Optional[List[Tuple[float, int, int, int, int]]] = [] if want_table else None
-    if grand_total <= 0:
-        return best, table
-
-    for seed in range(n_cells):
-        zone_cells = order[seed]
-        running = np.zeros(n_days)
-        for zsize in range(1, max_spatial_cells + 1):
-            running = running + counts[zone_cells[zsize - 1]]
-            zone_total = float(running.sum())
-            if zone_total <= 0:
-                continue
-            cum = np.concatenate(([0.0], np.cumsum(running)))
-            for length in range(min_window_days, max_window_days + 1):
-                obs = cum[length:] - cum[:-length]
-                t_tot = day_cum[length:] - day_cum[:-length]
-                exp = zone_total * t_tot / grand_total
-                llr = kulldorff_llr(obs, exp, grand_total)
-                idx = int(np.argmax(llr))
-                val = float(llr[idx])
-                if want_table:
-                    table.append((val, seed, zsize, idx, length))
-                if val > best[0]:
-                    best = (val, seed, zsize, idx, length)
-    return best, table
-
-
-# --------------------------------------------------------------------------- reporting
-
-
-@dataclass
-class SpaceTimeCluster:
-    rank: int  # 1 = most likely cluster, 2+ = secondary (non-overlapping)
-    cell_ids: List[str]
-    centroid: Tuple[float, float]  # mean (lat, lon) of the zone's cells
-    start_date: "object"  # pandas.Timestamp
-    end_date: "object"  # pandas.Timestamp, inclusive
-    n_days: int
-    observed: float
-    expected: float
-    relative_risk: float  # observed / expected
-    llr: float
-    p_value: float
-
-
-def _zone_cell_ids(order_row: np.ndarray, zsize: int, cell_ids: Sequence[str]) -> List[str]:
-    return [cell_ids[i] for i in order_row[:zsize]]
-
-
-def _overlaps(a_cells: set, a_start: int, a_len: int, b_cells: set, b_start: int, b_len: int) -> bool:
-    if a_cells.isdisjoint(b_cells):
-        return False
-    return not (a_start + a_len <= b_start or b_start + b_len <= a_start)
-
-
-def scan_space_time(
-    table: CellDayTable,
-    max_spatial_cells: int = DEFAULT_MAX_SPATIAL_CELLS,
-    min_window_days: int = DEFAULT_MIN_WINDOW_DAYS,
-    max_window_days: int = DEFAULT_MAX_WINDOW_DAYS,
-    n_sims: int = DEFAULT_N_SIMS,
-    max_clusters: int = DEFAULT_MAX_CLUSTERS,
-    rng: Optional[np.random.Generator] = None,
-) -> List[SpaceTimeCluster]:
-    """Scan ``table`` for the most likely space-time cluster and up to
-    ``max_clusters - 1`` further non-overlapping secondary clusters,
-    with Monte Carlo p-values from ``n_sims`` date permutations.
-
-    ``table`` is normally the output of :func:`build_cell_day_table` (or
-    the ``*_from_detections`` wrapper below, which builds it for you).
-    Permuting is done at the point level (shuffling
-    ``table.point_day_idx`` while keeping ``table.point_cell_idx``
-    fixed), which is what makes the null exactly preserve both the
-    per-cell and the per-day totals (see the module docstring) -- this
-    is why the function takes the per-point indices rather than only
-    the aggregated matrix.
-    """
-    rng = rng or np.random.default_rng()
-    n_cells, n_days = table.counts.shape
-    order = neighbor_order(table.cell_ids, table.cell_coords)
-
-    best, candidates = _scan_core(
-        table.counts, order, max_spatial_cells, min_window_days, max_window_days, want_table=True
-    )
-    if best[0] < 0 or not candidates:
-        return []
-
-    # Null distribution of the MAXIMUM llr over n_sims date-permutations.
-    # This is the standard (conservative) way every reported cluster,
-    # not only the single best one, gets a p-value: Kulldorff (1997).
-    null_max = np.empty(n_sims)
-    for b in range(n_sims):
-        perm_days = rng.permutation(table.point_day_idx)
-        perm_counts = _rebuild_counts(table.point_cell_idx, perm_days, n_cells, n_days)
-        rep_best, _ = _scan_core(
-            perm_counts, order, max_spatial_cells, min_window_days, max_window_days, want_table=False
-        )
-        null_max[b] = rep_best[0]
-
-    def p_value_of(llr: float) -> float:
-        return float((1 + np.sum(null_max >= llr)) / (1 + n_sims))
-
-    # Greedy non-overlapping secondary clusters, ranked by llr.
-    candidates.sort(key=lambda c: -c[0])
-    day_totals = table.counts.sum(axis=0)
-    day_cum = np.concatenate(([0.0], np.cumsum(day_totals)))
-    grand_total = float(day_totals.sum())
-
-    chosen: List[SpaceTimeCluster] = []
-    chosen_spans: List[Tuple[set, int, int]] = []
-    for llr, seed, zsize, start, length in candidates:
-        if len(chosen) >= max_clusters:
-            break
-        cells = set(_zone_cell_ids(order[seed], zsize, table.cell_ids))
-        if any(_overlaps(cells, start, length, pc, ps, pl) for pc, ps, pl in chosen_spans):
-            continue
-
-        zone_total = float(table.counts[order[seed][:zsize]].sum())
-        t_tot = float(day_cum[start + length] - day_cum[start])
-        exp = zone_total * t_tot / grand_total if grand_total > 0 else 0.0
-        obs = float(
-            table.counts[np.ix_(order[seed][:zsize], np.arange(start, start + length))].sum()
-        )
-        lat = float(np.mean([table.cell_coords[c][0] for c in cells]))
-        lon = float(np.mean([table.cell_coords[c][1] for c in cells]))
-
-        chosen.append(
-            SpaceTimeCluster(
-                rank=len(chosen) + 1,
-                cell_ids=sorted(cells),
-                centroid=(lat, lon),
-                start_date=table.dates[start],
-                end_date=table.dates[start + length - 1],
-                n_days=length,
-                observed=obs,
-                expected=exp,
-                relative_risk=(obs / exp) if exp > 0 else float("inf"),
-                llr=llr,
-                p_value=p_value_of(llr),
-            )
-        )
-        chosen_spans.append((cells, start, length))
-
-    return chosen
-
-
-def scan_space_time_from_detections(
