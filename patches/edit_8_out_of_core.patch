+            if not nm or not nv:
+                raise SystemExit("Both MODIS and VIIRS standardized files must contain usable rows.")
+            (ms, me), (vs, ve) = (_coverage(conn, "modis", "modis"), _coverage(conn, "viirs", "viirs"))
+            t0, t1 = max(ms, vs), min(me, ve)
