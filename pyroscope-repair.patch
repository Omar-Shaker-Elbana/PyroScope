-+        merged = pd.concat([current, add], ignore_index=True)
-+    if len(merged) > cap:
-+        idx = np.argpartition(merged["_sample_hash"].to_numpy(dtype=np.uint64), cap - 1)[:cap]
-+        merged = merged.iloc[idx]
-+    return merged.reset_index(drop=True)
