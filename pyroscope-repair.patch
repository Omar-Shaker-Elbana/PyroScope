---- /dev/null
-+++ b/pyroscope/stats/spacetime_scan.py
-@@ -0,0 +1,530 @@
-+"""
-+Space-time cluster detection for the Burning Activity Calendar.
-+
-+Context
-+-------
-+Today the anomaly detector sums every grid cell in the AOI into a single
-+daily number (calendar_daily.csv) and looks for anomalies along that one
-+time axis. That hides anything genuinely local: a real spatiotemporal
-+spike confined to one corner of the AOI can be averaged away by normal
-+activity everywhere else, and conversely a modest AOI-wide anomaly can
-+really be one small area burning unusually intensely rather than a
-+region-wide event. The review's fix is a proper space-time scan
-+statistic instead of a purely temporal one.
-+
-+This module implements the retrospective space-time permutation scan
-+statistic (Kulldorff 1997; Kulldorff, Heffernan, Hartman, Assuncao &
-+Mostashari, 2005, "A space-time permutation scan statistic for disease
-+outbreak detection", PLoS Medicine), adapted from disease counts to fire
-+detections:
-+
-+* A candidate cluster is a cylinder: a spatial zone (a seed cell plus its
-+  nearest neighbours on the SAME 0.5-degree grid calendar_cells.csv
-+  already uses -- see docs/METHODOLOGY.md section 4 for why that grid
-+  size -- so this does not introduce a second, uncoordinated spatial
-+  resolution) crossed with a contiguous run of days.
-+* The "permutation" null model needs no population-at-risk denominator
-+  (which this project does not have): under the null of no space-time
-+  interaction, a cylinder's expected count is
-+      expected = (total detections in the zone, all days)
-+               * (total detections in the window, all cells)
-+               / (grand total detections in the whole study region)
-+  i.e. location and date are independent. This is exactly Kulldorff's
-+  permutation model, and the reason it is a good fit here: it only
-+  needs the detections this project already has, not a population
-+  baseline.
-+* Kulldorff's (1997) log-likelihood-ratio statistic ranks every
-+  candidate cylinder; the most likely cluster is the one with the
-+  largest LLR. Significance is a Monte Carlo p-value: the date of every
-+  detection is randomly permuted (independently of its cell) many
-+  times, which preserves BOTH marginals exactly -- each cell's total
-+  count over the whole period, and each day's total count over the
-+  whole AOI -- and the same scan is re-run on each permuted copy to
-+  build a null distribution of the maximum LLR (Dwass 1957 / Kulldorff
-+  1997). A cluster's p-value is the share of the null replicates whose
-+  own best cylinder is at least as extreme.
-+
-+Composes with the other review items already shipped:
-+* Run this on ``pyroscope.pipeline.fire_type.vegetation_fires_only(df)``,
-+  not the raw hotspot table, so a flare field (steady, type 2) is never
-+  scanned as if it were a wildfire cluster.
-+* The clusters returned here are a DIFFERENT kind of evidence from a
-+  ``pyroscope.stats.climatology.changepoint_regimes`` regime: a regime
-+  is a change in the WHOLE AOI's mean over a (typically long) stretch;
-+  a cylinder here is a LOCAL excess over a (typically short) one. They
-+  will often, but need not, agree, and neither replaces the other.
-+* If you want an FDR-controlled flag across the clusters this module
-+  returns (rather than reading ``p_value`` directly against a fixed
-+  alpha), feed ``[c.p_value for c in clusters]`` into
-+  ``pyroscope.stats.fdr.benjamini_hochberg``.
-+
-+Performance. For ``n_cells`` grid cells, a spatial-zone cap of
-+``max_spatial_cells``, a temporal-window cap of ``max_window_days`` and
-+``n_days`` days in the study period, one full scan costs
-+O(n_cells * max_spatial_cells * max_window_days * n_days) -- every
-+window length is evaluated for every nested zone with one vectorized
-+numpy pass over all start days, which is why that is tractable at all.
-+Monte Carlo significance repeats the full scan ``n_sims`` times. The
-+defaults below deliberately scan for SUB-SEASONAL, LOCAL clusters (this
-+project's own anomaly_events.csv episodes run 3-10 days; AOI-wide,
-+multi-year regime shifts are what changepoint_regimes is for instead),
-+which keeps the window cap small; even so, this is the most expensive
-+diagnostic in the pipeline and is meant to be run deliberately on a
-+calendar already narrowed to an AOI, not on a continental or global run
-+(see review item 8). Measured on a grid the size of this project's own
-+shipped Egypt example (101 cells at the default 0.5-degree grid, 4,000+
-+days of history) with the default spatial/temporal caps: one full scan
-+is about 3-4 seconds, so the default PYRO_SCAN_N_SIMS=199 is roughly
-+12-15 minutes end to end (minimum achievable p-value 1/200 = 0.005).
-+Lower PYRO_SCAN_N_SIMS for quick iteration; raise it (Kulldorff's own
-+papers typically use 999) for a final run, and lower
-+PYRO_SCAN_MAX_SPATIAL_CELLS / PYRO_SCAN_MAX_WINDOW_DAYS if that is still
-+too slow for your AOI.
-+
-+No dependency beyond numpy; pandas is optional and only used by the two
-+``*_from_detections`` / ``*_from_cell_day_frame`` convenience wrappers
-+that build the cell x day table for you.
-+"""
-+
-+from __future__ import annotations
-+
-+import os
-+from dataclasses import dataclass
-+from typing import Dict, List, Optional, Sequence, Tuple
-+
-+import numpy as np
-+
-+__all__ = [
-+    "assign_cells",
-+    "build_cell_day_table",
-+    "neighbor_order",
-+    "kulldorff_llr",
-+    "SpaceTimeCluster",
-+    "scan_space_time",
-+    "scan_space_time_from_detections",
-+]
-+
-+# Mirrors the PYRO_*-style env-var knobs used throughout the rest of the
-+# pipeline (PYRO_CELL_DEG, PYRO_ANOM_WINDOW, PYRO_N_BOOT, ...).
-+DEFAULT_CELL_DEG = float(os.environ.get("PYRO_CELL_DEG", "0.5"))
-+DEFAULT_MAX_SPATIAL_CELLS = int(os.environ.get("PYRO_SCAN_MAX_SPATIAL_CELLS", "15"))
-+DEFAULT_MIN_WINDOW_DAYS = int(os.environ.get("PYRO_SCAN_MIN_WINDOW_DAYS", "1"))
-+DEFAULT_MAX_WINDOW_DAYS = int(os.environ.get("PYRO_SCAN_MAX_WINDOW_DAYS", "30"))
-+DEFAULT_N_SIMS = int(os.environ.get("PYRO_SCAN_N_SIMS", "199"))
-+DEFAULT_MAX_CLUSTERS = int(os.environ.get("PYRO_SCAN_MAX_CLUSTERS", "5"))
-+
-+# Same approximation already used elsewhere in this project (e.g. the
-+# synthetic-data generator in selftest.py) for a quick lat/lon -> km
-+# conversion. Only used here to ORDER neighbouring cells by distance, so
-+# the lat/lon-cell-is-not-equal-area caveat (docs/METHODOLOGY.md 4.4)
-+# matters even less than it does elsewhere.
-+KM_PER_DEG = 111.2
-+
-+
-+# --------------------------------------------------------------------------- grid
-+
-+
-+def assign_cells(
-+    lat: Sequence[float], lon: Sequence[float], cell_deg: float = DEFAULT_CELL_DEG
-+) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:
-+    """Assign each (lat, lon) to a cell on the same kind of lat/lon grid
-+    calendar_cells.csv already uses, and return (cell_id, cell_lat,
-+    cell_lon): a string id and the CENTRE coordinates of that cell.
-+    """
-+    lat = np.asarray(lat, dtype=float)
-+    lon = np.asarray(lon, dtype=float)
-+    lat_idx = np.floor(lat / cell_deg).astype(np.int64)
-+    lon_idx = np.floor(lon / cell_deg).astype(np.int64)
-+    cell_id = np.array([f"{a}_{b}" for a, b in zip(lat_idx, lon_idx)])
-+    cell_lat = (lat_idx + 0.5) * cell_deg
-+    cell_lon = (lon_idx + 0.5) * cell_deg
-+    return cell_id, cell_lat, cell_lon
-+
-+
-+@dataclass
-+class CellDayTable:
-+    counts: np.ndarray  # (n_cells, n_days) float
-+    cell_ids: List[str]
-+    cell_coords: Dict[str, Tuple[float, float]]  # cell_id -> (lat, lon) centre
-+    dates: "object"  # pandas.DatetimeIndex, one entry per column of counts
-+    point_cell_idx: np.ndarray  # (n_points,) int, row into counts/cell_ids
-+    point_day_idx: np.ndarray  # (n_points,) int, column into counts/dates
-+
-+
-+def build_cell_day_table(
-+    df,
-+    date_col: str = "acq_date",
-+    lat_col: str = "latitude",
-+    lon_col: str = "longitude",
-+    cell_deg: float = DEFAULT_CELL_DEG,
-+    cell_id_col: Optional[str] = None,
-+) -> CellDayTable:
-+    """Turn a detections table into a (cell x day) count matrix, plus the
-+    per-point (cell, day) indices the Monte Carlo permutation step needs.
-+
-+    If ``cell_id_col`` is given, cells are taken from that column
-+    directly (e.g. an existing calendar_cells.csv ``cell_id``) instead of
-+    being recomputed from lat/lon, so the two never drift apart; its
-+    centre coordinates are still read from ``lat_col`` / ``lon_col`` on
-+    a representative row of each cell (only used for neighbour
-+    ordering, so an approximate centre is fine).
-+    """
-+    import pandas as pd
-+
-+    work = df.copy()
-+    if cell_id_col is None:
-+        cid, clat, clon = assign_cells(work[lat_col], work[lon_col], cell_deg)
-+        work["_cell_id"] = cid
-+        coord_lookup: Dict[str, Tuple[float, float]] = {}
-+        for c, a, b in zip(cid, clat, clon):
-+            coord_lookup.setdefault(c, (float(a), float(b)))
-+    else:
-+        work["_cell_id"] = work[cell_id_col].astype(str)
-+        coord_lookup = {}
-+        for c, a, b in zip(work["_cell_id"], work[lat_col], work[lon_col]):
-+            coord_lookup.setdefault(c, (float(a), float(b)))
-+
-+    work["_date"] = pd.to_datetime(work[date_col]).dt.normalize()
-+    cell_ids = sorted(work["_cell_id"].unique())
-+    cell_index = {c: i for i, c in enumerate(cell_ids)}
-+    dates = pd.date_range(work["_date"].min(), work["_date"].max(), freq="D")
-+    day_index = {d: i for i, d in enumerate(dates)}
-+
-+    point_cell_idx = work["_cell_id"].map(cell_index).to_numpy(dtype=np.int64)
-+    point_day_idx = work["_date"].map(day_index).to_numpy(dtype=np.int64)
-+    counts = _rebuild_counts(point_cell_idx, point_day_idx, len(cell_ids), len(dates))
-+    cell_coords = {c: coord_lookup[c] for c in cell_ids}
-+
-+    return CellDayTable(
-+        counts=counts,
-+        cell_ids=cell_ids,
-+        cell_coords=cell_coords,
-+        dates=dates,
-+        point_cell_idx=point_cell_idx,
-+        point_day_idx=point_day_idx,
-+    )
-+
-+
-+def _rebuild_counts(cell_idx: np.ndarray, day_idx: np.ndarray, n_cells: int, n_days: int) -> np.ndarray:
-+    """(cell x day) count matrix from per-point indices -- O(n_points),
-+    used both for the observed table and for every Monte Carlo replicate
-+    (where day_idx has been permuted but cell_idx has not)."""
-+    flat = cell_idx * n_days + day_idx
-+    return np.bincount(flat, minlength=n_cells * n_days).astype(float).reshape(n_cells, n_days)
-+
-+
-+def neighbor_order(cell_ids: Sequence[str], cell_coords: Dict[str, Tuple[float, float]]) -> np.ndarray:
-+    """For every cell, the indices of all cells ordered by increasing
-+    (approximate) distance from it, itself first. Growing a spatial zone
-+    by taking the first ``k`` entries of one row gives a nested sequence
-+    of circular zones around that seed cell."""
-+    n = len(cell_ids)
-+    lat = np.array([cell_coords[c][0] for c in cell_ids])
-+    lon = np.array([cell_coords[c][1] for c in cell_ids])
-+    order = np.empty((n, n), dtype=np.int64)
-+    for i in range(n):
-+        dlat = (lat - lat[i]) * KM_PER_DEG
-+        dlon = (lon - lon[i]) * KM_PER_DEG * np.cos(np.radians(lat[i]))
-+        order[i] = np.argsort(dlat**2 + dlon**2, kind="stable")
-+    return order
-+
-+
-+# --------------------------------------------------------------------------- statistic
-+
-+
-+def kulldorff_llr(obs, exp, total: float) -> np.ndarray:
-+    """Kulldorff's (1997) log-likelihood-ratio statistic for an EXCESS of
-+    count ``obs`` where ``exp`` is the null-expected count and ``total``
-+    is the grand total over the whole space-time study region.
-+    Vectorized over ``obs`` / ``exp`` arrays of matching shape.
-+
-+    Only excess is scored (``obs <= exp`` -> 0): this project is looking
-+    for a real spatiotemporal spike, never an anomalously QUIET cluster,
-+    matching how the rest of the anomaly pipeline only flags elevated
-+    activity. Degenerate inputs (exp <= 0, or exp/obs at the grand
-+    total) also score 0 rather than raising, since a predominantly empty
-+    permuted replicate can produce them.
-+    """
-+    obs = np.asarray(obs, dtype=float)
-+    exp = np.asarray(exp, dtype=float)
-+    llr = np.zeros(np.broadcast(obs, exp).shape)
-+    ok = (obs > exp) & (exp > 0) & (exp < total) & (obs < total)
-+    o, e = obs[ok], exp[ok]
-+    llr[ok] = o * np.log(o / e) + (total - o) * np.log((total - o) / (total - e))
-+    return llr
-+
-+
-+def _scan_core(
-+    counts: np.ndarray,
-+    order: np.ndarray,
-+    max_spatial_cells: int,
-+    min_window_days: int,
-+    max_window_days: int,
-+    want_table: bool,
-+):
-+    """One full cylinder scan of a (cell x day) count table.
-+
-+    Returns (best, table): ``best`` is (llr, seed_idx, zone_size, start,
-+    length) for the single most likely cluster; ``table`` is the same
-+    5-tuple for every candidate cylinder when ``want_table`` is True
-+    (used to extract secondary clusters), else None (the fast path used
-+    for every Monte Carlo replicate, where only the maximum is needed).
-+    """
-+    n_cells, n_days = counts.shape
-+    max_spatial_cells = min(max_spatial_cells, n_cells)
-+    max_window_days = min(max_window_days, n_days)
-+
-+    day_totals = counts.sum(axis=0)
-+    day_cum = np.concatenate(([0.0], np.cumsum(day_totals)))
-+    grand_total = float(day_totals.sum())
-+
-+    best = (-1.0, -1, 0, 0, 0)
-+    table: Optional[List[Tuple[float, int, int, int, int]]] = [] if want_table else None
-+    if grand_total <= 0:
-+        return best, table
-+
-+    for seed in range(n_cells):
-+        zone_cells = order[seed]
-+        running = np.zeros(n_days)
-+        for zsize in range(1, max_spatial_cells + 1):
-+            running = running + counts[zone_cells[zsize - 1]]
-+            zone_total = float(running.sum())
-+            if zone_total <= 0:
-+                continue
-+            cum = np.concatenate(([0.0], np.cumsum(running)))
-+            for length in range(min_window_days, max_window_days + 1):
-+                obs = cum[length:] - cum[:-length]
-+                t_tot = day_cum[length:] - day_cum[:-length]
-+                exp = zone_total * t_tot / grand_total
-+                llr = kulldorff_llr(obs, exp, grand_total)
-+                idx = int(np.argmax(llr))
-+                val = float(llr[idx])
-+                if want_table:
-+                    table.append((val, seed, zsize, idx, length))
-+                if val > best[0]:
-+                    best = (val, seed, zsize, idx, length)
-+    return best, table
-+
-+
-+# --------------------------------------------------------------------------- reporting
-+
-+
-+@dataclass
-+class SpaceTimeCluster:
-+    rank: int  # 1 = most likely cluster, 2+ = secondary (non-overlapping)
-+    cell_ids: List[str]
-+    centroid: Tuple[float, float]  # mean (lat, lon) of the zone's cells
-+    start_date: "object"  # pandas.Timestamp
-+    end_date: "object"  # pandas.Timestamp, inclusive
-+    n_days: int
-+    observed: float
-+    expected: float
-+    relative_risk: float  # observed / expected
-+    llr: float
-+    p_value: float
-+
-+
-+def _zone_cell_ids(order_row: np.ndarray, zsize: int, cell_ids: Sequence[str]) -> List[str]:
-+    return [cell_ids[i] for i in order_row[:zsize]]
-+
-+
-+def _overlaps(a_cells: set, a_start: int, a_len: int, b_cells: set, b_start: int, b_len: int) -> bool:
-+    if a_cells.isdisjoint(b_cells):
-+        return False
