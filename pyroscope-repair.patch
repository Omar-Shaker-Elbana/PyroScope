-+def _sample_append(current: pd.DataFrame, incoming: pd.DataFrame, cap: int,
-+                   columns: list[str]) -> pd.DataFrame:
-+    """Keep the smallest stable 64-bit row hashes: deterministic, bounded reservoir."""
-+    if incoming.empty or cap <= 0:
