-diff --git a/pyroscope/stats/climatology.py b/pyroscope/stats/climatology.py
-new file mode 100644
-index 0000000..e64c875
---- /dev/null
-+++ b/pyroscope/stats/climatology.py
-@@ -0,0 +1,461 @@
-+"""
-+Replacement for the seasonal-naive (median/MAD, ±PYRO_ANOM_WINDOW-day
-+window) anomaly baseline, covering all three sub-points raised in the
-+review:
-+
-+1. ``fit_harmonic_regression`` — a smooth climatology (trend + a few
-+   Fourier terms) fit once over the whole series, instead of pooling a
-+   rolling window across years. No PYRO_ANOM_WINDOW knob: the number of
-+   harmonics (``n_harmonics``) plays that role but is far less sensitive
-+   to its exact value than a window width is.
-+
-+2. ``pelt_changepoints`` / ``changepoint_regimes`` — exact PELT
-+   (Killick et al. 2012) over the residual series, used to find the
-+   statistically justified onset/end of a fire season (a real mean
-+   shift) instead of a fixed "days above the 75th percentile" rule.
-+
-+3. ``circular_block_bootstrap_replicate`` / ``block_bootstrap_pvalues`` /
-+   ``expected_false_positives_block_bootstrap`` — a nonparametric,
-+   dependence-preserving null model built by resampling whole blocks of
-+   the actual residuals, instead of assuming a single-lag AR(1) process.
-+
-+Pipeline this is meant to replace
-+----------------------------------
-+    old: rolling median/MAD over +/- PYRO_ANOM_WINDOW days -> z-score ->
-+         flag z >= 2 -> "critical window" = z above a fixed percentile ->
-+         expected-false-positive estimate from a simulated AR(1) null
-+
-+    new: harmonic regression over the whole series -> residuals ->
-+         standardize residuals by a robust sigma to get a z-like score
-+         (same shape as before, so apply_fdr_to_frame from
-+         pyroscope.stats.fdr and vegetation_fires_only from
-+         pyroscope.pipeline.fire_type both still work unchanged) ->
-+         PELT on the standardized residuals finds the elevated regime(s)
-+         instead of a percentile cut -> block_bootstrap_pvalues gives a
-+         per-day p-value that doesn't assume normality or a single
-+         autocorrelation lag, which is what should be fed into
-+         benjamini_hochberg instead of the normal-null z_to_pvalue when
-+         you want the FDR step to be robust to leftover autocorrelation.
-+
-+No dependency beyond numpy.
-+"""
-+
-+from __future__ import annotations
-+
-+from dataclasses import dataclass
-+from typing import Callable, List, Optional, Sequence
-+
-+import numpy as np
-+
-+__all__ = [
-+    "fit_harmonic_regression",
-+    "robust_sigma",
-+    "pelt_changepoints",
-+    "changepoint_regimes",
-+    "circular_block_bootstrap_replicate",
-+    "block_bootstrap_null_stats",
-+    "block_bootstrap_pvalues",
-+    "expected_false_positives_block_bootstrap",
-+]
-+
-+
-+# ---------------------------------------------------------------------------
-+# 1. Harmonic regression climatology
-+# ---------------------------------------------------------------------------
-+
-+def fit_harmonic_regression(
-+    t_days: Sequence[float],
-+    y: Sequence[float],
-+    n_harmonics: int = 3,
-+    trend_degree: int = 1,
-+    period: float = 365.25,
-+):
-+    """Fit value ~ polynomial trend + n_harmonics Fourier pairs at the
-+    given period, by ordinary least squares.
-+
-+    Parameters
-+    ----------
-+    t_days : time coordinate in days (e.g. days since the series start,
-+        or since 2000-01-01 — any consistent origin works, it only
-+        affects the trend coefficients' scale, not the fit quality).
-+    y : the observed daily series (fire count, FRP sum, whatever the
-+        anomaly detector currently runs on).
-+    n_harmonics : number of annual-cycle Fourier pairs. 3 is a reasonable
-+        default (captures an annual cycle plus two overtones); raise it
-+        if the true seasonal shape is sharply peaked rather than smooth.
-+    trend_degree : 0 = no trend term, 1 = linear, 2 = quadratic, etc.
-+    period : the seasonal period in days. 365.25 for an annual cycle;
-+        pass a different value (or call this twice and add) if there's
-+        a secondary known periodicity worth modeling explicitly.
-+
-+    Returns
-+    -------
-+    fitted : np.ndarray, same length as y — the smooth climatology.
-+    residual : np.ndarray — y - fitted. This is the input the rest of
-+        this module (and the existing z-score / FDR steps) should run
-+        on instead of y itself.
-+    coef : np.ndarray — the fitted regression coefficients, in case you
-+        want to predict the climatology at new dates later without
-+        refitting.
-+    """
-+    t = np.asarray(t_days, dtype=float)
-+    y = np.asarray(y, dtype=float)
-+
-+    design_cols = [np.ones_like(t)]
-+    for d in range(1, trend_degree + 1):
-+        col = t**d
-+        design_cols.append(col / (np.max(np.abs(col)) or 1.0))  # scale for conditioning
-+    for k in range(1, n_harmonics + 1):
-+        design_cols.append(np.cos(2 * np.pi * k * t / period))
-+        design_cols.append(np.sin(2 * np.pi * k * t / period))
-+    X = np.column_stack(design_cols)
-+
-+    coef, *_ = np.linalg.lstsq(X, y, rcond=None)
-+    fitted = X @ coef
-+    residual = y - fitted
-+    return fitted, residual, coef
-+
-+
-+def robust_sigma(x: Sequence[float]) -> float:
-+    """MAD-based robust sigma estimate — the same estimator the existing
-+    pipeline already uses for its z-scores, kept here so residuals from
-+    the harmonic fit are standardized the same way the old window-pooled
-+    deviations were (so the z >= 2 cutoff, dashboards, etc. keep meaning
-+    what they already mean).
-+    """
-+    x = np.asarray(x, dtype=float)
-+    med = np.median(x)
-+    mad = np.median(np.abs(x - med))
-+    return float(1.4826 * mad) if mad > 0 else float(np.std(x))
-+
-+
-+# ---------------------------------------------------------------------------
-+# 2. PELT changepoint detection
-+# ---------------------------------------------------------------------------
-+
-+def pelt_changepoints(
-+    x: Sequence[float], penalty: Optional[float] = None, min_size: int = 5
-+) -> List[int]:
-+    """Exact PELT (Killick, Fearnhead & Eckley 2012) for a change in
-+    mean, with the standard L2 (sum-of-squared-deviations) segment
-+    cost, computed via prefix sums in O(1) per segment so the overall
-+    cost stays close to the method's advertised linear time.
-+
-+    Parameters
-+    ----------
-+    x : the series to search for mean shifts in — typically the
-+        standardized residuals from fit_harmonic_regression, not the
-+        raw counts.
-+    penalty : the per-changepoint penalty (beta). If None, defaults to
-+        the standard Gaussian-mean-shift BIC penalty 2 * sigma^2 *
-+        log(n), with sigma estimated robustly via robust_sigma on ``x``.
-+        Raise it to find fewer, larger regime changes; lower it to find
-+        more, smaller ones.
-+    min_size : minimum segment length. Prevents PELT from reporting a
-+        "regime change" that's really just a couple of noisy days.
-+
-+    Returns
-+    -------
-+    List of changepoint indices (0-based positions where a new segment
-+    starts; index 0 is never included). An empty list means no
-+    statistically justified mean shift was found anywhere in the series.
-+    """
-+    x = np.asarray(x, dtype=float)
-+    n = len(x)
-+    if n < 2 * min_size:
-+        return []
-+
-+    if penalty is None:
-+        sigma2 = max(robust_sigma(x) ** 2, 1e-12)
-+        penalty = 2.0 * sigma2 * np.log(max(n, 2))
-+
-+    cs = np.concatenate(([0.0], np.cumsum(x)))
-+    cs2 = np.concatenate(([0.0], np.cumsum(x * x)))
-+
-+    def seg_cost(s: int, e: int) -> float:
-+        length = e - s
-+        if length <= 0:
-+            return 0.0
-+        total = cs[e] - cs[s]
-+        total2 = cs2[e] - cs2[s]
-+        return total2 - (total * total) / length
-+
-+    F = [0.0] * (n + 1)
-+    F[0] = -penalty
-+    back = [0] * (n + 1)
-+    R = [0]
-+
-+    for t in range(1, n + 1):
-+        best_val = np.inf
-+        best_tau = 0
-+        candidate_costs = {}
-+        for tau in R:
-+            c = seg_cost(tau, t)
-+            candidate_costs[tau] = c
-+            if t - tau < min_size:
-+                continue
-+            val = F[tau] + c + penalty
-+            if val < best_val:
-+                best_val = val
-+                best_tau = tau
-+        if not np.isfinite(best_val):
-+            # no candidate yet satisfies min_size (we're early in the
-+            # series) — fall back to "everything so far is one segment"
-+            best_val = candidate_costs.get(0, seg_cost(0, t))
-+            best_tau = 0
-+        F[t] = best_val
-+        back[t] = best_tau
-+        R = [tau for tau in R if F[tau] + candidate_costs[tau] <= F[t]]
-+        R.append(t)
-+
-+    cps: List[int] = []
-+    t = n
-+    while t > 0:
-+        tau = back[t]
-+        if tau > 0:
-+            cps.append(tau)
-+        t = tau
-+    cps.reverse()
-+    return cps
-+
-+
-+@dataclass
-+class Regime:
-+    start: int
-+    end: int  # exclusive
-+    mean: float
-+    z: float  # segment mean standardized by the whole-series robust sigma
-+    elevated: bool
-+
-+
-+def changepoint_regimes(
-+    x: Sequence[float],
-+    penalty: Optional[float] = None,
-+    min_size: int = 5,
-+    elevated_z_threshold: float = 0.0,
-+) -> List[Regime]:
-+    """Run PELT and summarize each resulting segment.
-+
-+    This is the direct replacement for "days above the 75th percentile
-+    of climatology": a segment is a "critical window" (``elevated=True``)
-+    if its own mean, standardized by the whole series' robust sigma, is
-+    above ``elevated_z_threshold`` — a break the data itself justified,
-+    not a quantile chosen a priori.
-+    """
-+    x = np.asarray(x, dtype=float)
-+    n = len(x)
-+    sigma = robust_sigma(x) or 1.0
-+    overall_median = np.median(x)
-+
-+    cps = pelt_changepoints(x, penalty=penalty, min_size=min_size)
-+    bounds = [0] + cps + [n]
-+
-+    regimes = []
-+    for s, e in zip(bounds[:-1], bounds[1:]):
-+        seg_mean = float(np.mean(x[s:e]))
-+        z = (seg_mean - overall_median) / sigma
-+        regimes.append(Regime(start=s, end=e, mean=seg_mean, z=z, elevated=z > elevated_z_threshold))
-+    return regimes
-+
-+
-+# ---------------------------------------------------------------------------
-+# 3. Block bootstrap null model
-+# ---------------------------------------------------------------------------
-+
-+def circular_block_bootstrap_replicate(
-+    x: Sequence[float], block_size: int, rng: np.random.Generator
-+) -> np.ndarray:
-+    """One synthetic series of the same length as ``x``, built by
-+    concatenating blocks of length ``block_size`` drawn with replacement
-+    from the circular extension of ``x`` (Politis & Romano 1992).
-+    Unlike an AR(1) simulation this makes no parametric assumption about
-+    the dependence structure — whatever autocorrelation or leftover
-+    seasonal pattern survives within a block is carried into the
-+    replicate intact.
-+    """
-+    x = np.asarray(x, dtype=float)
-+    n = len(x)
-+    n_blocks = int(np.ceil(n / block_size))
-+    starts = rng.integers(0, n, size=n_blocks)
-+    out = np.empty(n_blocks * block_size)
-+    for i, s in enumerate(starts):
-+        idx = (np.arange(block_size) + s) % n
-+        out[i * block_size : (i + 1) * block_size] = x[idx]
-+    return out[:n]
-+
-+
-+def _default_block_size(n: int) -> int:
-+    # n^(1/3) is the standard rate-optimal default for block bootstrap.
-+    return max(2, int(round(n ** (1 / 3))))
-+
-+
-+def block_bootstrap_null_stats(
-+    residuals: Sequence[float],
-+    statistic_fn: Callable[[np.ndarray], float],
-+    block_size: Optional[int] = None,
-+    n_boot: int = 1000,
-+    rng: Optional[np.random.Generator] = None,
-+) -> np.ndarray:
-+    """Monte Carlo null distribution of ``statistic_fn`` under
-+    resampling, the block-bootstrap analogue of simulating many AR(1)
-+    series and recording the statistic on each one.
-+
-+    Use this for any statistic that depends on the *joint* behavior of
-+    the series — e.g. "how many days in a 4000-day run have |z| >= 2",
-+    or "what's the longest run of consecutive elevated days" — where the
-+    autocorrelation structure actually matters, as opposed to a single
-+    day's marginal p-value (see ``block_bootstrap_pvalues`` for that).
-+    """
-+    residuals = np.asarray(residuals, dtype=float)
-+    n = len(residuals)
-+    if block_size is None:
-+        block_size = _default_block_size(n)
-+    rng = rng or np.random.default_rng()
-+
-+    stats = np.empty(n_boot)
-+    for b in range(n_boot):
-+        rep = circular_block_bootstrap_replicate(residuals, block_size, rng)
-+        stats[b] = statistic_fn(rep)
-+    return stats
-+
-+
-+def expected_false_positives_block_bootstrap(
-+    residuals: Sequence[float],
-+    z_threshold: float = 2.0,
-+    block_size: Optional[int] = None,
-+    n_boot: int = 1000,
-+    rng: Optional[np.random.Generator] = None,
-+) -> float:
-+    """Block-bootstrap replacement for
-+    pyroscope.stats.fdr.expected_false_positive_count: instead of
-+    assuming iid (or single-lag-AR(1)) noise and computing the expected
-+    count analytically, this resamples the *actual* residuals (whatever
-+    their real autocorrelation is) and reports the average number of
-+    days crossing ``z_threshold`` per replicate. When the residuals are
-+    genuinely autocorrelated this number is typically larger than the
-+    iid-normal estimate (correlated noise clusters above a threshold
-+    together), which is exactly the gap the AR(1)-null critique in the
-+    review is about.
-+    """
-+    residuals = np.asarray(residuals, dtype=float)
-+    sigma = robust_sigma(residuals) or 1.0
-+    median = np.median(residuals)
-+
-+    def count_exceeding(rep: np.ndarray) -> float:
-+        z = (rep - median) / sigma
-+        return float(np.sum(z >= z_threshold))
-+
-+    stats = block_bootstrap_null_stats(
-+        residuals, count_exceeding, block_size=block_size, n_boot=n_boot, rng=rng
-+    )
-+    return float(stats.mean())
-+
-+
-+def block_bootstrap_pvalues(
-+    residuals: Sequence[float],
-+    block_size: Optional[int] = None,
-+    n_boot: int = 2000,
-+    tails: str = "greater",
-+    rng: Optional[np.random.Generator] = None,
-+) -> np.ndarray:
-+    """Per-day empirical p-value for each residual, from a pooled
-+    reference distribution built out of block-bootstrap replicates
-+    rather than assumed to be standard normal.
-+
-+    These feed directly into pyroscope.stats.fdr.benjamini_hochberg in
-+    place of z_to_pvalue(z) when you want the FDR step itself to not
-+    inherit a normality assumption the data may not satisfy:
-+
-+        p = block_bootstrap_pvalues(residuals)
-+        bh = benjamini_hochberg(p, q=0.05)
-+
-+    Note on scope: pooling across replicates gives a nonparametric
-+    marginal null (fixing the "assumed Gaussian" half of the AR(1)
-+    critique) but does not by itself test whether a *run* of several
-+    elevated days together is unusual given the autocorrelation — for
-+    that, use block_bootstrap_null_stats with a run-length or
-+    windowed-sum statistic instead.
-+    """
-+    residuals = np.asarray(residuals, dtype=float)
-+    n = len(residuals)
-+    if block_size is None:
-+        block_size = _default_block_size(n)
-+    rng = rng or np.random.default_rng()
-+
-+    pooled = np.empty(n_boot * n)
-+    for b in range(n_boot):
-+        pooled[b * n : (b + 1) * n] = circular_block_bootstrap_replicate(residuals, block_size, rng)
-+
-+    # Sorted pooled reference + searchsorted instead of an O(n * n_boot*n)
-+    # pairwise comparison — matters once n and n_boot both reach the
-+    # ~1,000-4,000 scale this pipeline runs at.
-+    n_ref = len(pooled)
-+    if tails == "greater":
-+        sorted_ref = np.sort(pooled)
-+        idx = np.searchsorted(sorted_ref, residuals, side="left")
-+        counts_ge = n_ref - idx
-+        p = (1 + counts_ge) / (1 + n_ref)
-+    elif tails == "two-sided":
-+        sorted_ref_abs = np.sort(np.abs(pooled))
-+        idx = np.searchsorted(sorted_ref_abs, np.abs(residuals), side="left")
-+        counts_ge = n_ref - idx
-+        p = (1 + counts_ge) / (1 + n_ref)
-+    else:
-+        raise ValueError("tails must be 'greater' or 'two-sided'")
-+    return p
-+
-+
-+if __name__ == "__main__":
-+    # Self-test / usage demo — run with `python -m pyroscope.stats.climatology`.
-+    rng = np.random.default_rng(0)
-+    n = 4 * 365  # four years of daily data, matching the ~4,000-test scale
-+
-+    t = np.arange(n, dtype=float)
-+    seasonal = 15 + 10 * np.cos(2 * np.pi * (t - 200) / 365.25)  # peak ~day 200 each year
-+    trend = 0.002 * t
-+
-+    # AR(1) noise so the series has real autocorrelation, like the
-+    # pipeline's residuals do after a harmonic fit.
-+    noise = np.empty(n)
-+    noise[0] = rng.normal(0, 3)
-+    phi = 0.6
-+    for i in range(1, n):
-+        noise[i] = phi * noise[i - 1] + rng.normal(0, 3 * np.sqrt(1 - phi**2))
-+
-+    y = np.clip(seasonal + trend + noise, 0, None)
-+
-+    # inject one real fire-season anomaly: a 10-day spike in year 3
-+    spike_start = 2 * 365 + 190
-+    y[spike_start : spike_start + 10] += 40
-+
-+    # --- 1. harmonic regression ---
-+    fitted, resid, _ = fit_harmonic_regression(t, y, n_harmonics=3, trend_degree=1)
-+    assert np.corrcoef(fitted, seasonal + trend)[0, 1] > 0.9, "harmonic fit should track the true seasonal+trend shape"
-+    print(f"harmonic fit R^2-ish corr with truth: {np.corrcoef(fitted, seasonal + trend)[0, 1]:.3f}")
-+
-+    sigma = robust_sigma(resid)
-+    z = resid / sigma
-+
-+    # --- 2. PELT regimes ---
-+    regimes = changepoint_regimes(z, min_size=5, elevated_z_threshold=1.0)
-+    elevated_days = sum(r.end - r.start for r in regimes if r.elevated)
-+    hit = any(r.start <= spike_start < r.end and r.elevated for r in regimes)
-+    print(f"PELT found {len(regimes)} regimes, {elevated_days} elevated days total; "
-+          f"injected spike caught in an elevated regime: {hit}")
-+    assert hit, "the injected 10-day spike should land inside a PELT-flagged elevated regime"
-+
-+    # --- 3. block bootstrap null ---
-+    naive_iid_expected = n * (0.5 * __import__("math").erfc(2.0 / np.sqrt(2)))
-+    bb_expected = expected_false_positives_block_bootstrap(resid, z_threshold=2.0, n_boot=300, rng=rng)
-+    print(f"expected false positives at z>=2 -- iid-normal assumption: {naive_iid_expected:.1f}, "
-+          f"block-bootstrap (honest about the real autocorrelation): {bb_expected:.1f}")
-+    assert bb_expected > naive_iid_expected, (
-+        "with real AR(1) autocorrelation in the residuals, the block-bootstrap expected "
-+        "false-positive count should exceed the naive iid-normal estimate"
-+    )
-+
-+    p = block_bootstrap_pvalues(resid, n_boot=300, tails="greater", rng=rng)
-+    assert p[spike_start] < 0.01, "the injected spike should get a very small block-bootstrap p-value"
-+    assert np.median(p) > 0.3, "most ordinary days should not look extreme under the bootstrap null"
-+
-+    print("self-test OK")
