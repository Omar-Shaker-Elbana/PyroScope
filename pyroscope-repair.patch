-+HORIZONS = list(range(1, 15))
-+CLIM_YEARS = 12
-+FEATURES = [
-+    "h", "lag0", "lag1", "lag2", "lag6",
-+    "mean3", "mean7", "mean14", "mean30", "mean90",
-+    "max7", "ratio7_30", "active14",
-+    "doy_sin", "doy_cos", "clim_mean", "clim_max",
