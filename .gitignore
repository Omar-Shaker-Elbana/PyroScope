.cache/
.temp/
tmp/
output.tst
output.txt
output-old.txt
session
HotSync_harmonized Final.html

# ==========================================
# Local MCD64A1 archive and download state
# ==========================================
MCD64A1/[0-9][0-9][0-9][0-9]/
MCD64A1/*.hdf
MCD64A1/*.bak
MCD64A1/*.backup
MCD64A1/__pycache__/
MCD64A1/download_manifest.csv
MCD64A1/download_manifest.before_*.csv
