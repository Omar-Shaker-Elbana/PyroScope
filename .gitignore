MCD64A1/.mcd64_cookies.txt

# Local recovery backups
MCD64A1_repair_backup_*/
external_validation_backup_*/
external_validation_retry_backup_*/

# Local diagnostic logs and reports
*_stdout.txt
*_stderr.txt
mcd64_gdal_scan_*.txt
mcd64_target_test_*.txt
